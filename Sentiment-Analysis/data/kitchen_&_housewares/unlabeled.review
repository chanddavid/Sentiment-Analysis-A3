</unique_id>
<asin>
B00011HH22
</asin>
<product_name>
Sanyo HPS-SG3 200-Square-Inch Electric Indoor Barbeque Grill, Black: Kitchen & Housewares
</product_name>
<product_type>
kitchen & housewares
</product_type>
<helpful>
