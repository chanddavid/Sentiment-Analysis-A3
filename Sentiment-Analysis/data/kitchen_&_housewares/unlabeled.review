<unique_id>
B0002MH3NS:whisper_quiet_and_powerful_food_processor:craig
</unique_id>
<asin>
B0002MH3NS
</asin>
<product_name>
KitchenAid KFP750CR 700-Watt 12-Cup Food Processor, Chrome: Kitchen & Housewares
</product_name>
<product_type>
