<unique_id>
B0001OY2W2:a_specialty_pair_of_earbuds_for_a_budget_price.:william_h._thomas
</unique_id>
<asin>
B0001OY2W2
</asin>
<product_name>
Philips HE592 Surround Sound Ear Buds (White): Electronics
</product_name>
<product_type>
electronics
</product_type>
<helpful>
