B0007TIYA2:outstanding_features_and_performance_worth_twice_the_price.:pinbyte
</unique_id>
<asin>
B0007TIYA2
</asin>
<product_name>
Uniden DCT648-3 2.4 GHz Digital Expandable Cordless Phone with 3 Handsets and Digital Answering System (Silver/Black): Electronics
</product_name>
<product_type>
electronics
</product_type>
<helpful>
