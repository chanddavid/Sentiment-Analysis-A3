B0001OHH5G:correcting_some_factual_errors:matt_greenfield
</unique_id>
<asin>
B0001OHH5G
</asin>
<product_name>
Monster Cable HDMI 400 DVI-2M High-Definition Video Interconnect 2 Meters: Electronics
</product_name>
<product_type>
electronics
</product_type>
<helpful>
10 of 10
</helpful>
<rating>
