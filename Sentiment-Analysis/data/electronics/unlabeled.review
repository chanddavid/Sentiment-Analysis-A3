<unique_id>
B00004SY4H:the_king:owen_oyer_"q3catscratch"
</unique_id>
<asin>
B00004SY4H
</asin>
<product_name>
Sennheiser HD600 Traditional Over-Ear Open Dynamic Hi-Fi Professional Stereo Headphones (Black): Electronics
</product_name>
<product_type>
electronics
</product_type>
<helpful>
