<unique_id>
B0000CEPC0:reliability_and_poor_documentation_are_problems:peter_a._stark
</unique_id>
<asin>
B0000CEPC0
</asin>
<product_name>
D-Link DCS-900 10/100TX Internet Camera, Home Security: Electronics
</product_name>
<product_type>
