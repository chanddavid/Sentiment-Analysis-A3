<unique_id>
B000A3WS84:music,_video_and_more:thomas_e._tweedel
</unique_id>
<asin>
B000A3WS84
</asin>
<product_name>
Apple 30 GB iPod with Video Playback Black (5th Generation): Electronics
</product_name>
<product_type>
