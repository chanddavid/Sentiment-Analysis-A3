<unique_id>
B00022TNGI:at_this_price_-_you_can't_go_wrong:jeffrey_eldredge_"jeffel"
</unique_id>
<asin>
B00022TNGI
</asin>
<product_name>
Kensington 33130 Portable Laptop Speakers (USB 2.0/1.1): Electronics
</product_name>
<product_type>
electronics
