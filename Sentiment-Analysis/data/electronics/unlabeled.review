B0003QER7S:best_remote_i've_used:jordan_brown
</unique_id>
<asin>
B0003QER7S
</asin>
<product_name>
Logitech Harmony 676 Universal Remote Control: Electronics
</product_name>
<product_type>
electronics
</product_type>
<helpful>
